{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "deposit",
        "final"
      ],
      "default": "deposit"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Amount in major units (USD)"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "paid",
        "void"
      ],
      "default": "draft"
    },
    "checkout_session_id": {
      "type": "string",
      "description": "Wix checkout session id; correlation key"
    },
    "purchase_id": {
      "type": "string",
      "description": "Base44Purchase id after checkout session created"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "customer_name",
    "type",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}