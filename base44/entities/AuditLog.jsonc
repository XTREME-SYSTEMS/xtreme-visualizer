{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "description": "Which entity was changed (Lead, WorkOrder, Invoice, etc.)"
    },
    "entity_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete"
      ]
    },
    "field_changes": {
      "type": "string",
      "description": "JSON string of changed fields and their old/new values"
    },
    "user_name": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "Human-readable summary of the change"
    }
  },
  "required": [
    "entity_type",
    "action"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}