{
  "name": "AutoLeadVerificationReceipt",
  "type": "object",
  "properties": {
    "opportunity_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "rejected"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by": {
      "type": "string"
    }
  },
  "required": [
    "opportunity_id",
    "status",
    "verified_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}