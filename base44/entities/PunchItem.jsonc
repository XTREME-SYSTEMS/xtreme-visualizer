{
  "name": "PunchItem",
  "type": "object",
  "properties": {
    "work_order_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "done": {
      "type": "boolean",
      "default": false
    },
    "step_order": {
      "type": "number",
      "default": 0
    },
    "signed_url": {
      "type": "string"
    },
    "signed_date": {
      "type": "string",
      "format": "date-time"
    },
    "signed_by": {
      "type": "string"
    }
  },
  "required": [
    "work_order_id",
    "label"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}