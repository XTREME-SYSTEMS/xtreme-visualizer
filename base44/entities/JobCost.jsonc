{
  "name": "JobCost",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "material_cost": {
      "type": "number",
      "default": 0
    },
    "labor_cost": {
      "type": "number",
      "default": 0
    },
    "fuel_cost": {
      "type": "number",
      "default": 0
    },
    "consumables_cost": {
      "type": "number",
      "default": 0
    },
    "other_cost": {
      "type": "number",
      "default": 0
    },
    "material_overage_pct": {
      "type": "number",
      "default": 30,
      "description": "Overage applied to predicted material quantity"
    },
    "predicted_total": {
      "type": "number",
      "default": 0
    },
    "actual_total": {
      "type": "number",
      "default": 0
    },
    "details": {
      "type": "array",
      "description": "Line breakdown \u2014 predicted vs actual per category",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "predicted": {
            "type": "number"
          },
          "actual": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "project_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}