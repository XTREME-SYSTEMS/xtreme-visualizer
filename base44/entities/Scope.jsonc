{
  "name": "Scope",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "square_feet": {
      "type": "number"
    },
    "slab_condition": {
      "type": "string",
      "enum": [
        "Good",
        "Fair",
        "Poor"
      ]
    },
    "crack_repair": {
      "type": "boolean"
    },
    "moisture_mitigation": {
      "type": "string",
      "enum": [
        "Recommended",
        "Required",
        "Not Needed"
      ]
    },
    "grinding_prep": {
      "type": "boolean"
    },
    "demolition": {
      "type": "boolean"
    },
    "coving": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "verified_on_site": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "project_id"
  ]
}