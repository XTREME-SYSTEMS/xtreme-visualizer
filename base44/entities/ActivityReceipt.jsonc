{
  "name": "ActivityReceipt",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "photo",
        "mask",
        "visualization",
        "quote",
        "proposal",
        "appointment",
        "validation",
        "audit"
      ],
      "default": "audit"
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}