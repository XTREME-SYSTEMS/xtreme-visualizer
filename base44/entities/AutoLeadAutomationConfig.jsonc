{
  "name": "AutoLeadAutomationConfig",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "scrape_cadence": {
      "type": "string",
      "enum": [
        "1h",
        "4h",
        "6h",
        "12h",
        "24h"
      ],
      "default": "24h"
    },
    "auto_takeoff": {
      "type": "string",
      "enum": [
        "auto",
        "review",
        "manual"
      ],
      "default": "review"
    },
    "auto_proposal": {
      "type": "string",
      "enum": [
        "auto",
        "review",
        "manual"
      ],
      "default": "review"
    },
    "auto_outreach": {
      "type": "string",
      "enum": [
        "auto",
        "review",
        "manual"
      ],
      "default": "review"
    },
    "notification_frequency": {
      "type": "string",
      "enum": [
        "realtime",
        "daily",
        "weekly"
      ],
      "default": "daily"
    },
    "autonomy_level": {
      "type": "string",
      "enum": [
        "full_auto",
        "semi_auto",
        "manual"
      ],
      "default": "semi_auto"
    },
    "data_class": {
      "type": "string",
      "enum": [
        "production",
        "NON_PRODUCTION_EXAMPLE"
      ],
      "default": "production"
    }
  },
  "required": [
    "scrape_cadence"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}