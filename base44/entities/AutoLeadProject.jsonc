{
  "name": "AutoLeadProject",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Verified project description extracted from the source"
    },
    "specs": {
      "type": "string",
      "description": "Project specifications (scope of work, materials, requirements) extracted from source documents"
    },
    "contract_info": {
      "type": "string",
      "description": "Contract / owner contact information (name, email, phone, address) extracted from source"
    },
    "project_type": {
      "type": "string",
      "description": "e.g. commercial, residential, municipal, industrial, renovation"
    },
    "jurisdiction": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "qualification",
        "takeoff",
        "estimating",
        "proposal",
        "submitted",
        "won",
        "lost"
      ],
      "default": "qualification"
    },
    "value": {
      "type": "number"
    },
    "bid_due_date": {
      "type": "string",
      "format": "date"
    },
    "client_name": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "trade": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "bidability_score": {
      "type": "number"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "verified",
        "failed"
      ],
      "default": "unverified"
    },
    "verified_date": {
      "type": "string",
      "format": "date-time"
    },
    "data_class": {
      "type": "string",
      "enum": [
        "production",
        "NON_PRODUCTION_EXAMPLE"
      ],
      "default": "production"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}