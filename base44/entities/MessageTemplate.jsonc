{
  "name": "MessageTemplate",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "template_type": {
      "type": "string",
      "enum": [
        "clarification",
        "proposal_delivery",
        "viewed_no_response",
        "reminder",
        "objection",
        "revised_proposal",
        "acceptance_confirmation",
        "signature_reminder",
        "deposit_reminder",
        "lost_feedback"
      ]
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "sent",
        "archived"
      ],
      "default": "draft"
    }
  },
  "required": [
    "template_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}