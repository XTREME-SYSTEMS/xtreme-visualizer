{
  "name": "WorkOrder",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "project_address": {
      "type": "string"
    },
    "scope_items": {
      "type": "array",
      "description": "Scope-of-work items copied from the approved proposal (price omitted on the work order)",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "materials_list": {
      "type": "array",
      "description": "Materials speced for the job with calculated qty + 30% overage",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "cost": {
            "type": "number"
          }
        }
      }
    },
    "crew_leader_id": {
      "type": "string"
    },
    "crew_leader_name": {
      "type": "string"
    },
    "subcontractor_id": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "assigned",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "draft"
    },
    "job_cost_id": {
      "type": "string"
    },
    "calendar_event_id": {
      "type": "string"
    },
    "calendar_link": {
      "type": "string"
    },
    "drive_folder_id": {
      "type": "string"
    },
    "drive_folder_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}