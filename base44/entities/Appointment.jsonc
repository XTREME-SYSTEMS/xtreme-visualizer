{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "requested_date": {
      "type": "string",
      "format": "date"
    },
    "requested_window": {
      "type": "string",
      "enum": [
        "morning",
        "midday",
        "afternoon",
        "evening"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "consultation",
        "site_visit",
        "virtual"
      ],
      "default": "consultation"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "confirmed",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "requested"
    },
    "message": {
      "type": "string"
    },
    "confirmed_start": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime when the appointment is scheduled to begin"
    },
    "confirmed_end": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "number",
      "default": 60
    },
    "location": {
      "type": "string",
      "description": "Job site or meeting address"
    },
    "calendar_event_id": {
      "type": "string",
      "description": "Google Calendar event id after sync"
    },
    "calendar_link": {
      "type": "string",
      "description": "Google Calendar event HTML link"
    },
    "prep_notes": {
      "type": "string",
      "description": "AI-generated contractor prep briefing"
    },
    "prep_notes_generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customer_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}