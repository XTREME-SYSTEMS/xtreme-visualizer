{
  "name": "BrandAsset",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string",
      "description": "Uploaded or AI-generated logo"
    },
    "brand_direction": {
      "type": "string",
      "enum": [
        "revenue_gold",
        "clarity_white",
        "closing_room"
      ],
      "default": "revenue_gold"
    },
    "primary_color": {
      "type": "string",
      "default": "#0A0A0A"
    },
    "accent_color": {
      "type": "string",
      "default": "#F5C542"
    },
    "tagline": {
      "type": "string"
    },
    "email_signature": {
      "type": "string"
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}