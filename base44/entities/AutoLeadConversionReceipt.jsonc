{
  "name": "AutoLeadConversionReceipt",
  "type": "object",
  "properties": {
    "opportunity_id": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "converted",
        "duplicate",
        "blocked"
      ]
    },
    "detail": {
      "type": "string"
    },
    "converted_at": {
      "type": "string",
      "format": "date-time"
    },
    "converted_by": {
      "type": "string"
    }
  },
  "required": [
    "opportunity_id",
    "status",
    "converted_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}