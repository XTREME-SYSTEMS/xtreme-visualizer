{
  "name": "ChangeOrder",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price_change": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "approved",
        "rejected"
      ],
      "default": "draft"
    },
    "customer_signature_url": {
      "type": "string"
    },
    "signed_date": {
      "type": "string",
      "format": "date-time"
    },
    "esign_document_id": {
      "type": "string"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "project_id",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}