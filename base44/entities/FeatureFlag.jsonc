{
  "name": "FeatureFlag",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "environment": {
      "type": "string",
      "enum": [
        "sandbox",
        "preview",
        "production"
      ],
      "default": "sandbox"
    },
    "description": {
      "type": "string"
    },
    "approval_required": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}