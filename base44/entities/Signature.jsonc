{
  "name": "Signature",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "signer_name": {
      "type": "string"
    },
    "signer_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "requested",
        "viewed",
        "signed",
        "declined"
      ]
    },
    "signature_asset_url": {
      "type": "string"
    },
    "signed_at": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "status"
  ]
}