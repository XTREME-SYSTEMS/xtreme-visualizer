{
  "name": "Lost Lead Recovery",
  "description": "Daily check for leads marked 'lost' 30+ days ago. Sends a win-back email with a revised offer and 10% discount.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 10 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "lost_lead_recovery",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_recovery": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runLostLeadRecovery",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send win-back emails",
            "description": "Finds lost leads 30+ days old and sends recovery emails"
          }
        }
      }
    ]
  }
}