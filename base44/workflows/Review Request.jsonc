{
  "name": "Review Request",
  "description": "Daily check for work orders completed 7 days ago. Sends a Google review request to the customer.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 11 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "review_request",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reviews": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runReviewRequests",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send review requests",
            "description": "Finds jobs completed 7 days ago and emails customers for Google reviews"
          }
        }
      }
    ]
  }
}